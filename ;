import 'package:app/ui/core/spacing/app_spacing.dart';
import 'package:app/ui/core/widgets/shared_page_layout.dart';
import 'package:app/ui/user/widgets/login_form.dart';
import 'package:app/ui/user/widgets/register_form.dart';
import 'package:flutter/cupertino.dart';

enum VisisbleWidget { login, register }

class LoginRegisterView extends StatefulWidget {
  const LoginRegisterView({super.key});

  @override
  State<LoginRegisterView> createState() => _LoginRegisterViewState();
}

class _LoginRegisterViewState extends State<LoginRegisterView> {
  VisisbleWidget? _visibleWidget = VisisbleWidget.login;
  @override
  Widget build(BuildContext context) {
    return SharedPageLayout(
      trailing: const SizedBox.shrink(),
      title: _visibleWidget == VisisbleWidget.login ? "Login" : "Register",
      child: Padding(
        padding: const EdgeInsets.all(AppSpacing.two),
        child: Column(
          children: [
            Padding(
              padding: const EdgeInsets.all(AppSpacing.one),
              child: CupertinoSlidingSegmentedControl<VisisbleWidget>(
                groupValue: _visibleWidget,
                onValueChanged: ((value) => setState(() {
                  _visibleWidget = value;
                })),
                children: {
                  VisisbleWidget.login: const Text('Login'), 
                  VisisbleWidget.register: const Text('Register'),
                },
              ),
            ),
          ],
        ),
      ),
    );
  }
}
